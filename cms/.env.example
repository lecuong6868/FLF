# Sao chép thành .env và điền giá trị thật. KHÔNG commit file .env.
# Sinh secret/mật khẩu thử: bash scripts/generate-preview-secrets.sh

# PostgreSQL — dùng DATABASE_URL hoặc DATABASE_URI (cả hai đều được)
DATABASE_URL=postgresql://flf:flf_local_only@127.0.0.1:5432/flf
# DATABASE_URI=postgresql://flf:flf_local_only@127.0.0.1:5432/flf

# Bí mật Payload (chuỗi ngẫu nhiên dài ≥ 32 ký tự)
PAYLOAD_SECRET=thay_bang_chuoi_ngau_nhien_dai_it_nhat_32_ky_tu

# URL công khai của app
# Local: http://localhost:3000
# Render: để trống (dùng RENDER_EXTERNAL_URL) hoặc dán https://xxx.onrender.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Bản thử: chặn index Google + banner cảnh báo
PREVIEW_MODE=true

# Seed khi container start (Render/Railway)
SEED_ON_START=false
SEED_UPDATE_PASSWORD=false

# Tài khoản admin seed (bắt buộc khi chạy npm run seed)
SEED_ADMIN_EMAIL=admin@flf.local
SEED_ADMIN_PASSWORD=thay_bang_mat_khau_manh

# Tài khoản editor seed (kiểm thử phân quyền)
SEED_EDITOR_EMAIL=editor@flf.local
SEED_EDITOR_PASSWORD=thay_bang_mat_khau_manh

# Tuỳ chọn docker-compose local
POSTGRES_USER=flf
POSTGRES_PASSWORD=flf_local_only
POSTGRES_DB=flf
POSTGRES_PORT=5432
