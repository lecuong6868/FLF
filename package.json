{
  "name": "renew-web-flf-preview",
  "version": "1.3.0",
  "private": true,
  "description": "Preview HTML FLF — trang chủ, Giới thiệu, Quy định mới, Chuyên mục VI/EN; xuất bản GitHub Pages /FLF/",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 4173 --directory FLF-preview",
    "serve": "python3 -m http.server 4173 --directory FLF-preview",
    "gen:sections": "node scripts/gen-bilingual-sections.mjs",
    "verify:home": "node scripts/verify-home-bilingual.mjs",
    "verify:about": "node scripts/verify-about-bilingual.mjs",
    "verify:sections": "node scripts/verify-sections-bilingual.mjs",
    "verify:basepath": "node scripts/verify-basepath-local.mjs",
    "verify:preview": "node scripts/verify-preview-url.mjs",
    "verify": "npm run verify:home && npm run verify:about && npm run verify:sections && npm run verify:basepath",
    "capture:home": "node scripts/capture-home.mjs",
    "capture:about": "node scripts/capture-about.mjs",
    "pack:offline": "node scripts/pack-offline-preview.mjs",
    "offline": "npm run verify:home && npm run verify:about && npm run verify:sections && npm run pack:offline",
    "check": "npm run verify"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  }
}
